<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="header-container">
      <a href="/" class="brand-link">
        <span class="brand-icon" aria-hidden="true">&#x25C8;</span>
        <span class="brand-name">FormGuard</span>
      </a>
      <nav class="header-nav">
        <a href="/" class="nav-link">Return to Home</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="error-container">
      <div class="error-code"><%= status %></div>
      <h1 class="error-title">Internal Server Error</h1>
      <p class="error-text"><%= message %></p>
      <% if (stack) { %>
        <pre class="stack-trace"><%= stack %></pre>
      <% } %>
      <div style="margin-top: 2rem;">
        <a href="/" class="btn-secondary">&larr; Back to Registration Demo</a>
      </div>
    </div>
  </main>
</body>
</html>
